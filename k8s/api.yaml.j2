apiVersion: v1
kind: Service
metadata:
  name: shortener-api
spec:
  selector:
    app: shortener-api
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: shortener-api
spec:
  selector:
    matchLabels:
      app: shortener-api
  template:
    metadata:
      labels:
        app: shortener-api
    spec:
      containers:
        - name: api
          image: {{ app_image | to_json }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8000
          env:
            - name: DATABASE_URL
              value: postgresql://shortener@db:5432/shortener
            # 8 replicas x (10 pooled + 1 health) connections stays under max_connections=100.
            - name: DB_POOL_MAX
              value: "10"
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: shortener-db
                  key: password
          resources:
            requests:
              cpu: 100m
              memory: 96Mi
          readinessProbe:
            httpGet:
              path: /health
              port: http
            timeoutSeconds: 4
            periodSeconds: 5
          livenessProbe:
            tcpSocket:
              port: http
            periodSeconds: 15
          lifecycle:
            # Keep serving while the Ingress and Service drop this pod from their
            # endpoints, so rollouts and scale-in do not refuse connections.
            preStop:
              exec:
                command: [sleep, "5"]
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: shortener-api
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: shortener-api
  minReplicas: 2
  maxReplicas: 8
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 65
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: shortener
spec:
  ingressClassName: {{ ingress_class | to_json }}
  rules:
    - host: {{ ingress_host | to_json }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: shortener-api
                port:
                  name: http
