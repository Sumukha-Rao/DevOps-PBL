# Copy to .env and adjust: cp .env.example .env
# Docker Compose reads .env from this folder automatically. Never commit .env.

# Host port the app is published on (bound to 127.0.0.1 only).
APP_PORT=8000

# Postgres password, used by both the db and app containers.
# Applied only when the pgdata volume is first created. To change it later,
# run `docker compose down -v` (this deletes all stored links) and start again.
POSTGRES_PASSWORD=change-me

# Only needed when building behind a TLS-inspecting proxy, together with
# `-f compose.yaml -f compose.build-ca.yaml`.
# BUILD_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
